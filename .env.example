# このファイルをコピーして .env という名前で保存し、= の右側に値を貼り付けてください。
# .env は .gitignore されているので GitHub には上がりません。
#
#   コピー方法（PowerShell）:
#     Copy-Item .env.example .env
#
# 書き方のルール:
#   - = の前後に空白を入れても構いません
#   - 値をクォートで囲む必要はありません（囲んでも動きます）
#   - # で始まる行はコメントとして無視されます

# ---- 楽天ウェブサービス ----------------------------------------------
# Rakuten Developers → アプリ情報の確認 で確認できます。
# https://webservice.rakuten.co.jp/app/list
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# ROOM投稿では使いません（ROOMが投稿時に自動でリンク化するため）。
# 将来ブログやSNSに展開するとき用。空のままでも動きます。
RAKUTEN_AFFILIATE_ID=

# ---- Anthropic --------------------------------------------------------
# console.anthropic.com → Settings → API keys → Create Key
# 発行直後の1回しか値が表示されないので、その場でコピーしてください。
ANTHROPIC_API_KEY=
